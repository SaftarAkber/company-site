"use client";
import { useState } from "react";

export type FaqItem = { q: string; a: string };

export const faqs: FaqItem[] = [
  {
    q: "Layihə üçün orta hazırlanma müddəti nə qədərdir?",
    a: "Layihənin həcmindən asılı olaraq dəyişir. Sadə bir sayt (landing page) adətən 1-2 həftəyə, daha kompleks veb tətbiqlər isə 4-8 həftəyə hazır olur. Dəqiq müddəti ilkin görüşdən sonra sənə təqdim edirik.",
  },
  {
    q: "Qiymətləndirmə necə aparılır?",
    a: "Qiymət, layihənin funksionallığından, dizayn tələblərindən və inteqrasiya ehtiyaclarından asılı olaraq fərdi hesablanır. Pulsuz ilkin konsultasiya zamanı sənə təxmini büdcə təqdim edirik.",
  },
  {
    q: "Hazır saytın dəstəyi (support) var?",
    a: "Bəli. Təhvil verildikdən sonra da texniki dəstək, yeniləmələr və təhlükəsizlik yamaqları üçün aylıq dəstək paketlərimiz mövcuddur.",
  },
  {
    q: "Hansı texnologiyalardan istifadə edirsiniz?",
    a: "Əsasən Next.js, React, TypeScript və Tailwind CSS üzərində müasir, sürətli və SEO-dostu veb saytlar qururuq. Backend tərəfdə ehtiyaca görə Prisma və müxtəlif verilənlər bazası həllərindən istifadə edirik.",
  },
  {
    q: "Mövcud saytımı yeniləmək mümkündürmü?",
    a: "Əlbəttə. Mövcud saytınızı analiz edib, performans, dizayn və ya funksionallıq baxımından yeniləmə təklifləri hazırlaya bilərik.",
  },
  {
    q: "Ödəniş şərtləri necədir?",
    a: "Adətən layihə başlamazdan əvvəl qismən ön ödəniş, təhvil zamanı isə qalan hissə tələb olunur. Böyük layihələr üçün mərhələli ödəniş planı da təklif edirik.",
  },
];

export default function FaqAccordion({ items = faqs }: { items?: FaqItem[] }) {
  const [openIndex, setOpenIndex] = useState<number | null>(0);

  return (
    <div className="flex flex-col divide-y divide-line-light border-t border-b border-line-light">
      {items.map((item, i) => {
        const isOpen = openIndex === i;
        return (
          <div key={item.q}>
            <button
              onClick={() => setOpenIndex(isOpen ? null : i)}
              className="w-full flex items-center justify-between gap-4 py-5 text-left group"
            >
              <span className="font-display text-base sm:text-lg text-graphite transition-colors duration-300 group-hover:text-accent">
                {item.q}
              </span>
              <span
                className={`shrink-0 w-8 h-8 rounded-full border border-line-light flex items-center justify-center text-accent transition-transform duration-300 ${
                  isOpen ? "rotate-45" : ""
                }`}
              >
                +
              </span>
            </button>
            <div
              className={`grid transition-all duration-300 ease-out ${
                isOpen ? "grid-rows-[1fr] opacity-100 pb-6" : "grid-rows-[0fr] opacity-0"
              }`}
            >
              <div className="overflow-hidden">
                <p className="text-graphite/70 leading-relaxed max-w-2xl">{item.a}</p>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  );
}
